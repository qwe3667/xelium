# ── Render will inject PORT automatically — do not set this manually ──
# PORT=5000

# PostgreSQL — use Render's built-in Postgres or an external DB
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Groq AI keys (get from console.groq.com)
GROQ_KEY_DEFENDER=gsk_...
GROQ_KEY_ATTACKER=gsk_...

# Your Netlify frontend URL (used for CORS — comma-separate multiple)
FRONTEND_URL=https://your-app.netlify.app

# Session secret — any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: log level (debug | info | warn | error)
# LOG_LEVEL=info

# Optional: admin panel password override
# ADMIN_SECRET=xelium_admin_2025
